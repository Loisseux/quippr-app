{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/privacy-policy.html", "dest": "/privacy-policy.html" },
    { "src": "/terms.html", "dest": "/terms.html" },
    { "src": "/delete-account.html", "dest": "/delete-account.html" },
    { "src": "/app-icon.png", "dest": "/app-icon.png" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
